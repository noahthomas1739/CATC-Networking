# Copy to .env for local development. NEVER commit real values.

# Runtime connection: the restricted catc_app role (created by migrations).
DATABASE_URL=postgres://catc_app:dev-app-password@localhost:5432/catc
# Owner connection, used ONLY by `npm run db:migrate`, seed and admin:invite.
DATABASE_URL_MIGRATE=postgres://catc_owner:dev-owner-password@localhost:5432/catc
# Password migrations assign to catc_app (must match DATABASE_URL above).
APP_DB_PASSWORD=dev-app-password

# Public origin of the site. Passkeys are bound to this hostname.
APP_URL=http://localhost:3000

# 32+ random characters: `openssl rand -base64 48`
HASH_SECRET=replace-me-with-a-long-random-string-from-openssl

# Email via Resend. Leave RESEND_API_KEY empty in development to write emails to .dev-mail/
RESEND_API_KEY=
EMAIL_FROM="CATC Directory <directory@your-domain.example>"

# Vercel Cron bearer secret (32+ chars). Optional locally.
CRON_SECRET=
