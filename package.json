{
  "name": "catc-networking",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env --conditions=react-server scripts/seed.ts",
    "admin:invite": "tsx --env-file-if-exists=.env --conditions=react-server scripts/create-admin-invite.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "16.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
